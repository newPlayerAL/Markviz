<Window x:Class="Markviz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Markviz" Height="720" Width="1080"
        Icon="app.ico"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Open}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenFile_Executed"/>
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="FileMenu">
                <MenuItem x:Name="OpenMenuItem" Command="ApplicationCommands.Open" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem x:Name="ExitMenuItem" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem x:Name="ToolsMenu">
                <MenuItem x:Name="RegisterMenuItem" Click="RegisterAssoc_Click"/>
                <MenuItem x:Name="UnregisterMenuItem" Click="UnregisterAssoc_Click"/>
            </MenuItem>
            <MenuItem x:Name="LanguageMenu">
                <MenuItem x:Name="LangZhMenuItem" Header="中文" Tag="zh" IsCheckable="True" Click="SetLanguage_Click"/>
                <MenuItem x:Name="LangEnMenuItem" Header="English" Tag="en" IsCheckable="True" Click="SetLanguage_Click"/>
            </MenuItem>
            <MenuItem x:Name="HelpMenu">
                <MenuItem x:Name="AboutMenuItem" Click="About_Click"/>
            </MenuItem>
        </Menu>
        <wv2:WebView2 x:Name="WebView"/>
    </DockPanel>
</Window>
